{
  "version": 2,
  "functions": {
    "api/index.js": {
      "runtime": "nodejs20.x"
    }
  },
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    { "source": "/videogames", "destination": "/api/index.js" },
    { "source": "/videogame/:path*", "destination": "/api/index.js" },
    { "source": "/genres", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/client/$1" }
  ]
}
